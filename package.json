{
  "name": "anaf-js",
  "version": "1.0.0",
  "description": "CIUS-RO compliant e-Invoice generator for Romanian ANAF e-Factura system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun build ./src/index.ts --outdir ./dist --target browser --format esm",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --target browser --format cjs",
    "build:types": "tsc --project tsconfig.build.json",
    "example": "bun run src/example.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "anaf",
    "efactura",
    "e-factura",
    "invoice",
    "xml",
    "ubl",
    "cius-ro",
    "romania",
    "tax",
    "factura",
    "romanian",
    "einvoice"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": "",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "xmlbuilder2": "^4.0.3"
  }
}
