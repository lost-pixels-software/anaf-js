{
  "name": "anaf-js",
  "version": "0.1.1",
  "description": "A comprehensive TypeScript library for the Romanian ANAF e-Factura system.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun build ./src/index.ts --outdir ./dist --target browser --format esm",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --target browser --format cjs",
    "build:types": "tsc && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "anaf",
    "efactura",
    "e-factura",
    "invoice",
    "xml",
    "ubl",
    "cius-ro",
    "romania",
    "tax",
    "factura",
    "romanian",
    "einvoice"
  ],
  "author": "Lost Pixels Software SRL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lost-pixels-software/anaf-js.git"
  },
  "homepage": "https://github.com/lost-pixels-software/anaf-js",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "xmlbuilder2": "^4.0.3"
  }
}
