{
  "name": "anaf-js",
  "version": "0.6.0",
  "description": "A comprehensive TypeScript library for the Romanian ANAF e-Factura system.",
  "keywords": [
    "anaf",
    "cius-ro",
    "e-factura",
    "efactura",
    "einvoice",
    "factura",
    "invoice",
    "romania",
    "romanian",
    "tax",
    "ubl",
    "xml"
  ],
  "homepage": "https://github.com/lost-pixels-software/anaf-js",
  "license": "MIT",
  "author": "Lost Pixels Software SRL",
  "repository": {
    "type": "git",
    "url": "https://github.com/lost-pixels-software/anaf-js.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.2",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.21.1",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
